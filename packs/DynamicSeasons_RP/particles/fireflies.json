{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "seasons:fireflies",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/seasons_firefly"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          12,
          2.5,
          12
        ],
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": 0.2,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "4 + v.particle_random_1 * 3"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 70 + v.particle_random_2 * 360) * 0.4",
          "math.sin(v.particle_age * 50 + v.particle_random_3 * 360) * 0.25",
          "math.cos(v.particle_age * 60 + v.particle_random_1 * 360) * 0.4"
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.07,
          0.07
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.85,
          1.0,
          0.35,
          "math.clamp(math.sin(v.particle_age * 120 + v.particle_random_2 * 360) * 1.5, 0, 1)"
        ]
      }
    }
  }
}
